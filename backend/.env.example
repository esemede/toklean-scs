# Red y contratos
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CHAIN_ID=11155111
DEPLOYMENTS_FILE=../deployments/11155111.json

# Servidor
HOST=0.0.0.0
PORT=8787
# URL pública del backend (se usa en los enlaces de archivos guardados localmente)
PUBLIC_BASE_URL=https://api.toklean.cl
# Dominios del frontend autorizados por CORS (coma). '*' sólo en desarrollo.
CORS_ORIGINS=https://toklean.cl
DATA_DIR=./.data

# Archivos: con JWT de Pinata se fijan en IPFS (producción). Sin él se guardan en DATA_DIR (sólo desarrollo).
PINATA_JWT=
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
# Hosts https extra de los que se aceptan imágenes y metadata (coma)
ALLOWED_HOSTS=

# Indexador
CONFIRMATIONS=2
POLL_INTERVAL_MS=10000
LOG_CHUNK_BLOCKS=2000
UPLOADS_PER_HOUR=60

# Keeper (opcional, paga el gas con esta cuenta): libera pedidos vencidos y retira fondos a sus dueños
KEEPER_PRIVATE_KEY=
KEEPER_AUTO_RELEASE=false
KEEPER_AUTO_WITHDRAW=false
KEEPER_INTERVAL_MS=60000
