# Nunca subas tu .env real. Usa una wallet de despliegue dedicada (sólo testnet).
PRIVATE_KEY=
# Polygon Amoy (chainId 80002). RPC público o de Alchemy/Infura/QuickNode.
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_RPC_URL=
# Ethereum Sepolia (chainId 11155111). RPC público o de Alchemy/Infura.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# API key de Etherscan (verificación en Sepolia). Opcional.
ETHERSCAN_API_KEY=
# API key de Etherscan V2 (sirve para Polygonscan) para verificar contratos. Opcional.
POLYGONSCAN_API_KEY=
# Mainnet: Safe multisig / Timelock. En testnet déjalo vacío para que el deployer sea admin.
ADMIN_ADDRESS=
IMAGE_BASE_URI=ipfs://CID/
# Wallets de prueba (separadas por coma) que recibirán todos los roles en testnet
TESTERS=
